# General
APP_ENV=development
APP_NAME=FrotaD
APP_TIMEZONE=America/Fortaleza

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-before-production

# PostgreSQL
POSTGRES_DB=frotad
POSTGRES_USER=frotad
POSTGRES_PASSWORD=frotad
DATABASE_URL=postgresql+psycopg://frotad:frotad@localhost:5432/frotad

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=frotad-local
S3_ACCESS_KEY=frotad
S3_SECRET_KEY=frotad-local-secret
S3_FORCE_PATH_STYLE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API address for web; configure in apps/web/.env.local
API_URL=http://localhost:8000
# Set the exact public origin behind a reverse proxy, e.g. https://app.example.com
# APP_ORIGIN=https://app.example.com
# Keep true in HTTPS production. Local Docker uses false because it serves HTTP.
# SESSION_COOKIE_SECURE=true
